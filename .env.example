# CourseConnect Environment Configuration
# Flask Configuration
SECRET_KEY=courseconnect_secret_key_change_in_production_jwt_98234
FLASK_ENV=development
PORT=5000

# Database Engine Configuration
# DB_ENGINE can be 'mysql' (strict MySQL Connector) or 'auto' (checks MySQL first, falls back to SQLite seamlessly if MySQL is offline)
DB_ENGINE=auto

# MySQL Configuration (Default for XAMPP / WampServer / Local MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=course_registration

# Fallback SQLite DB path (stored in database/course_registration.db)
SQLITE_DB_PATH=database/course_registration.db
